{
  "commitMessage": "📝 {{date}} 知识库自动备份",
  "commitDateFormat": "YYYY-MM-DD HH:mm:ss",
  "autoSaveInterval": 10,
  "autoPushInterval": 10,
  "autoPullInterval": 0,
  "autoPullOnBoot": true,
  "disablePush": false,
  "pullBeforePush": true,
  "disablePopups": true,
  "disableStatusBar": false,
  "listChangedFilesInMessageBody": true,
  "showStatusBar": true,
  "updateSubmodules": false,
  "syncMethod": "merge",
  "gitPath": "",
  "customMessageOnAutoBackup": true,
  "autoBackupAfterFileChange": true,
  "treeStructure": false,
  "refreshSourceControl": true
}
